{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
  "name": "@zhexin/typebox",
  "version": "1.13.38",
  "exports": {
    ".": "./mod.ts",
    "./certificate": "./certificate.ts",
    "./dns": "./dns.ts",
    "./endpoint": "./endpoint.ts",
    "./experimental": "./experimental.ts",
    "./inbound": "./inbound.ts",
    "./log": "./log.ts",
    "./ntp": "./ntp.ts",
    "./outbound": "./outbound.ts",
    "./route": "./route.ts",
    "./rule_set": "./rule_set.ts",
    "./service": "./service.ts"
  },
  "publish": {
    "include": [
      "./*.ts",
      "./README.md"
    ],
    "exclude": [
      ".github",
      "./schema.ts",
      "./*.test.ts"
    ]
  }
}
